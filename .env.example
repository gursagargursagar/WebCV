# Everything here is optional. The app runs with no configuration at all:
# `npm run dev`, then claim the site at /setup.

# --- Required for any production build ---
# Any long random string. The claim form asks for it, so a stranger who finds
# your site before you do cannot take ownership of it. `npm run dev` does not
# need it; `npm run build && npm run start` does, including on your own machine.
# There is no "it looked like localhost" exemption, because the only evidence of
# that is a header the caller chooses.
# OPB_SETUP_TOKEN=

# Allows the session cookie without the Secure flag, for testing a production
# build over plain HTTP on a machine you control. Never set this on a public
# site: it lets the session cookie travel unencrypted.
# OPB_ALLOW_INSECURE_COOKIES=1

# --- Storage ---
# Inferred from whichever backend's variables are present, so a one-click deploy
# needs no choice at all. Set this only to override that.
# Available: local | supabase | neon | postgres | pocketbase | firebase | appwrite | cloudflare
# OPB_ADAPTER=

# Supabase — Postgres + Storage in one project. Free tier: 500MB database,
# 1GB files. Note that a free project pauses after about a week with no
# database activity.
#   Project Settings -> API for the first two, Database -> Connection pooling
#   for the third. Use the POOLED connection string, not the direct one.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgres://...pooler.supabase.com:6543/postgres

# Neon + Vercel Blob — a database and an object store from two services. Neon
# suspends when idle but resumes in milliseconds, so a quiet site does not come
# back dead. Both provision one-click through the Vercel Marketplace, which sets
# these for you.
# DATABASE_URL=postgres://...neon.tech/neondb
# BLOB_READ_WRITE_TOKEN=

# Any Postgres works (Railway, Render, Fly, Coolify, self-hosted). The registry
# accepts OPB_POSTGRES_URL, DATABASE_URL, POSTGRES_URL and NEON_DATABASE_URL —
# whichever is present wins, in that order.
# OPB_POSTGRES_URL=postgres://user:pass@host:5432/opb

# Secrets — required to save service passwords from the admin (SMTP, etc.).
# The vault key is SHA256("opb.integration.vault.v1:" + OPB_SECRET_KEY ||
# OPB_SESSION_SECRET). Missing key → 409 on save, never silent plaintext.
# Change both in docker-compose.yml before first boot.
# OPB_SECRET_KEY=
# OPB_SESSION_SECRET=

# UPLOADS + local content live under OPB_DATA_DIR (/data in Docker).
# OPB_DATA_DIR=./.opb

# The local filesystem adapter is the default and needs nothing configured. It
# will refuse to run on Vercel, Netlify or Cloudflare, where the disk is
# discarded between deploys and your content would silently disappear.

# PocketBase — database and file storage in one self-hosted binary. Free tier:
# there is none to need; it runs on your own server, a VPS or a Raspberry Pi.
#   POCKETBASE_URL=http://127.0.0.1:8090 plus the admin login created when
#   PocketBase first booted.
# POCKETBASE_URL=
# POCKETBASE_ADMIN_EMAIL=
# POCKETBASE_ADMIN_PASSWORD=

# Firebase — Firestore for records, Cloud Storage for files, both on Google's
# free Spark tier. Needs a service account: Project Settings -> Service
# accounts -> Generate new private key. The private key may arrive with literal
# \n sequences; both forms are accepted.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Defaults to <project>.appspot.com.
# FIREBASE_STORAGE_BUCKET=

# Appwrite — documents and file storage in one self-hosted stack (or Appwrite
# Cloud). Create a project, then an API key with databases, collections,
# documents, files and buckets scopes.
# APPWRITE_ENDPOINT=http://localhost:8081/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=

# Cloudflare D1 + R2, embedded locally — no account, no API token. The D1
# SQLite engine and the R2 object API run in-process via Miniflare and persist
# under OPB_CLOUDFLARE_DIR (default: <data dir>/cloudflare). Runs on a VPS,
# Docker and Raspberry Pi; refused on ephemeral hosts, where the disk — and
# therefore the database — would vanish between deploys. The Workers-native
# REST binding against a real Cloudflare account is a separate slice that
# needs an account to verify, and is not built: setting CLOUDFLARE_ACCOUNT_ID
# and friends selects this local engine, never the cloud.
# OPB_ADAPTER=cloudflare
# OPB_CLOUDFLARE_DIR=./.opb-cloudflare

# --- The site's public URL ---
# Used for canonical links, Open Graph tags and the sitemap. Detected from the
# host when deployed; set it for local production builds.
# Also the only source for the domain a passphrase-reset link points at, and for
# newsletter confirmation and unsubscribe links — never the request's Host
# header, which the caller chooses. Without this set, both reset and newsletter
# sign-ups are unavailable in production (canonical links still fall back to the
# host). Passkeys use it as the WebAuthn relying-party identity when set;
# without it the request's own host is used instead.
# OPB_SITE_URL=https://example.com

# --- Demo sandbox (public demo only) ---
# OPB_DEMO_MODE=1
# --- GitHub device-flow for Help & feedback (optional) ---
# OPB_GITHUB_CLIENT_ID=
# --- Error reporting (optional, vendor-neutral webhook) ---
# Receives { message, path, method, requestId, version, at } on server errors.
# OPB_ERROR_WEBHOOK_URL=

# --- Optional: analytics (cookieless; nothing is recorded until set) ---
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_ANALYTICS_DOMAIN=example.com
# NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_SHARE_URL=

# --- Optional: email ---
# Without these nothing is sent: enquiries still reach your admin inbox, but
# nothing tells you they arrived, and there is no passphrase reset.
# Any SMTP server works. For local development:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   OPB_SMTP_HOST=localhost, OPB_SMTP_PORT=1025, inbox at http://localhost:8025
# OPB_SMTP_HOST=
# OPB_SMTP_PORT=587
# OPB_SMTP_USER=
# OPB_SMTP_PASSWORD=
# Implicit TLS, port 465 only. Everything else negotiates STARTTLS by itself.
# OPB_SMTP_SECURE=1
# Defaults to no-reply@<your SMTP host>.
# OPB_MAIL_FROM=

# --- Optional: the owner's monthly digest ---
# Sent by calling /api/cron/digest with this secret (Vercel Cron does it for
# you; elsewhere, a daily crontab line — see docs/self-hosting). Needs SMTP.
# CRON_SECRET=
# OPB_DIGEST=off

# --- Optional: where the app reaches itself (static copy) ---
# Defaults to http://127.0.0.1:$PORT. Never read from a request header.
# OPB_INTERNAL_URL=http://app:3000
