{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/core/*": ["../core/*"],
      "@/cms/*": ["../src/cms/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "_comment": "The product's files reach this program by being imported, not by a glob. Sweeping `../core/**` in explicitly pulled its whole test suite along, which needs vitest and @types/react — devDependencies the Vercel build deliberately omits. Excluding the test folders keeps that true if a glob ever comes back.",
  "exclude": ["node_modules", "out", "../core/**/__tests__/**", "../src/**/__tests__/**"]
}
